[Unit]
Description=DROP connectivity checker
Documentation=https://drop-de.quickdc.org/
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/dropd -config /etc/dropd/dropd.toml
Restart=on-failure
RestartSec=5s

User=dropd
Group=dropd

# The daemon binds 80, 443 and the low egress ports directly, because the
# specification forbids a reverse proxy: it needs the true peer address, and a
# proxy destroys it. This capability is the only privilege it needs.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
UMask=0077

# /var/lib/dropd, holding the ACME cache and the server secret.
StateDirectory=dropd
StateDirectoryMode=0700

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# AF_NETLINK is required, not optional: Go's resolver and interface
# enumeration use it, and omitting it produces DNS failures that look like
# network outages.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# The host has 458 MB of RAM in total. GOMEMLIMIT makes the Go collector work
# harder as it approaches the ceiling; MemoryMax is the hard backstop so that a
# runaway daemon is killed rather than taking sshd down with it.
Environment=GOMEMLIMIT=200MiB
MemoryMax=300M
MemoryHigh=250M
TasksMax=512
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
